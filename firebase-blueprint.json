{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with learning bookmarks, progress, and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 150,
          "description": "Public display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar photo URL"
        },
        "savedProjects": {
          "type": "array",
          "description": "List of bookmarked project slugs"
        },
        "savedRoadmaps": {
          "type": "array",
          "description": "List of bookmarked roadmap slugs"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator identity",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "superadmin"],
          "description": "Admin privileges tier"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Technical project or case study documentation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "slug": {
          "type": "string",
          "maxLength": 128,
          "description": "URL-friendly unique slug identifier"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Project title"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed project description"
        },
        "problem": {
          "type": "string",
          "maxLength": 2000,
          "description": "Engineering challenge and problem statement"
        },
        "architecture": {
          "type": "string",
          "maxLength": 3000,
          "description": "System architecture breakdown"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Category or domain (e.g. Systems, Networking, DevOps)"
        },
        "technologies": {
          "type": "array",
          "description": "List of core technologies"
        },
        "keyDecisions": {
          "type": "array",
          "description": "Key engineering decisions and trade-offs"
        },
        "githubUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "GitHub source repository URL"
        },
        "demoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Live preview or deployment URL"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the project is featured on the homepage"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["slug", "title", "category"]
    },
    "Roadmap": {
      "title": "Roadmap",
      "description": "Engineering career and technical progression roadmap",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID"
        },
        "slug": {
          "type": "string",
          "maxLength": 128,
          "description": "URL-friendly unique slug"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Roadmap title"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Roadmap summary and target audience"
        },
        "level": {
          "type": "string",
          "maxLength": 50,
          "description": "Target skill level (e.g., Beginner to Advanced)"
        },
        "duration": {
          "type": "string",
          "maxLength": 50,
          "description": "Estimated completion duration"
        },
        "prerequisites": {
          "type": "array",
          "description": "List of prerequisite skills"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the roadmap is highlighted on homepage"
        },
        "phases": {
          "type": "array",
          "description": "List of structured curriculum phases"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["slug", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with private bookmarks and settings"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Verified administrative credentials and privileges"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of engineering projects and case studies"
    },
    "/roadmaps/{roadmapId}": {
      "schema": "Roadmap",
      "description": "Collection of technical progression roadmaps"
    }
  }
}
